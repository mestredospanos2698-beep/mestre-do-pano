config.json

# Excel de stock — nunca versionado (dados privados/pessoais/comerciais)
Stock.xlsx

# Segredos locais do backend (Cloudflare Workers / wrangler dev)
backend/.dev.vars
backend/.env
.env
.env.*
!.env.example

# Python (tools/sync_stock.py) — nunca versionar bytecode compilado
__pycache__/
*.pyc

# Dependências / build
node_modules/
backend/node_modules/
backend/.wrangler/

# Sistema
.DS_Store
Thumbs.db
