# Mestre do Pano — backend/.env.example
#
# Copiar para ".dev.vars" (usado pelo `wrangler dev` para desenvolvimento
# local) e preencher com as credenciais REAIS da app PayPal Sandbox
# (developer.paypal.com -> My Apps & Credentials -> Sandbox).
#
# NUNCA:
#   - preencher este ficheiro com valores reais e depois fazer commit;
#   - colocar estas variáveis em produtos.json, shipping.json, HTML, CSS
#     ou qualquer ficheiro JavaScript público (GitHub Pages);
#   - partilhar o PAYPAL_CLIENT_SECRET, o PAYPAL_WEBHOOK_ID ou o
#     INPOST_API_TOKEN.
#
# Em produção (Cloudflare Workers), estes valores NÃO vão neste ficheiro —
# usar sempre:
#   wrangler secret put PAYPAL_CLIENT_ID
#   wrangler secret put PAYPAL_CLIENT_SECRET
#   wrangler secret put PAYPAL_WEBHOOK_ID
#   wrangler secret put INPOST_API_TOKEN
#   wrangler secret put INPOST_ORGANIZATION_ID
#
# As variáveis não-secretas (PAYPAL_ENVIRONMENT, ALLOWED_ORIGIN,
# PRODUCTS_URL, SHIPPING_URL, COUNTRIES_URL, CURRENCY,
# SHIPPING_ENVIRONMENT) já estão em wrangler.toml (secção [vars]) e podem
# ir para o repositório.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# --- Logística real (Fase 6) ------------------------------------------------
#
# InPost (ShipX API): estes valores só existem através de uma conta
# comercial InPost (painel "Manager"/"ShipX") — ver docs/shipping.md.
# Sem eles, InPostProvider recusa qualquer operação autenticada
# (getRates, createShipment, getLabel, trackShipment, cancelShipment)
# com o código NOT_CONFIGURED, em vez de simular uma resposta.
SHIPPING_ENVIRONMENT=sandbox
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=

# CTT: não existem variáveis de credenciais aqui nesta fase — não foi
# encontrada nenhuma API/sandbox pública dos CTT (ver docs/shipping.md).
# O provider "ctt" é um stub que recusa qualquer operação real até
# existir um contrato comercial com documentação de API.
